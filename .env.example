# --- Required -------------------------------------------------------------
# Password for the hiring dashboard at /admin
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie (openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-string
# Public URL of the site, used in links inside emails
BASE_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# Leave empty to store data in ./data/db.json (fine for local / single server).
# Set a Postgres URL (e.g. Neon, Supabase) for hosted deployments like Vercel.
DATABASE_URL=

# --- Email (SMTP) ---------------------------------------------------------
# Without SMTP settings, emails are NOT sent; they are logged in the dashboard
# so you can see exactly what would go out.
# Gmail: use smtp.gmail.com / 465 / your address / an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Divide Careers <careers@example.com>"
# Where "new application" and "interview booked" notifications go
ADMIN_NOTIFY_EMAIL=
